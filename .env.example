# Campus Grid & Infrastructure
LOCATION_NAME=Indore
LATITUDE=22.7196
LONGITUDE=75.8577
GRID_CAP_KW=850.0
SOLAR_PEAK_KW=250.0

# Tariffs (INR / kWh) & Emissions (kg CO2 / kWh)
TARIFF_PEAK_INR=9.0
TARIFF_NORMAL_INR=7.0
TARIFF_OFFPEAK_INR=5.5
